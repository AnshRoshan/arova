# Copy this file to .env.local (gitignored; Next.js loads it automatically).
# Never commit real keys. .env* is deny-listed for agents in .claude/settings.json.

# ── Database ───────────────────────────────────────────────────────────────────
# Point this at a database this project OWNS. On a shared Postgres host, do not
# reuse a database belonging to another app (drizzle-kit push would collide).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/arova_demo

# ── Built-in providers ─────────────────────────────────────────────────────────
# A key here makes the provider "configured"; without it chat stays in honest local mode.
XAI_API_KEY=
XAI_MODEL=grok-4
OPENAI_API_KEY=
FAST_MODEL=gpt-4o-mini

# ── Any OpenAI-compatible endpoint ─────────────────────────────────────────────
# 1. Add the provider's short name to PROVIDERS (space or comma separated).
# 2. Define <NAME>_BASE_URL, <NAME>_MODEL and <NAME>_API_KEY.
#    NAME is the provider name uppercased, with - and _ as separators:
#    "dahl" -> DAHL_*, "ollama-local" -> OLLAMA_LOCAL_*.
# 3. Restart the server. The provider appears in every agent's model picker — no code change.
#
# BASE_URL accepts either the API root (…/v1) or the full completions URL; the
# app appends /chat/completions itself. https is strongly recommended: the bearer
# key rides on this request. http is allowed only for a trusted local endpoint.
PROVIDERS=dahl
DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_MODEL=MiniMaxAI/MiniMax-M2.7
DAHL_API_KEY=
# Optional: this endpoint's context window in tokens. Caps how much chat history
# is sent per request (default 8192 for custom providers, 128000 for built-ins).
DAHL_MAX_CONTEXT=32000

# Self-hosted / LAN example (plain http is acceptable only on a trusted network):
# PROVIDERS="dahl ollama"
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=ollama
# OLLAMA_MAX_CONTEXT=8192

# ── Model call limits ──────────────────────────────────────────────────────────
# Model-call budget per workspace per provider per UTC day. 0 disables the limit.
# Absent = 60. Chats that stay in local mode are never counted.
DAILY_MODEL_CALLS_LIMIT=60
# How many teammates one answer may consult. Each hop costs extra model calls:
# a consulted answer is a routing call, the peer's call, then the integrating answer.
# 0 disables delegation entirely; 1 (default) is one peer hop.
MAX_DELEGATIONS=1

# Output cap per reply, and the unary / streaming response ceilings in ms.
MODEL_MAX_TOKENS=800
MODEL_TIMEOUT_MS=45000
MODEL_STREAM_TIMEOUT_MS=120000

# ── Future integrations: do not set these until provider adapters are implemented ─
# AUTH_SECRET=
# Comma-separated sign-in providers (env-driven, Feature 15). The flow activates only
# once a provider's client id + secret are present; empty keeps the cookie demo.
# AUTH_PROVIDERS=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# COMPOSIO_API_KEY=
# SANDBOX_PROVIDER=

# ── Local OS sandbox (optional; TASKS 1.9) ────────────────────────────────────
# Off unless AROVA_SANDBOX_PROVIDER says otherwise. Shell/files only: no desktop,
# browser stream, snapshot or takeover.
#   local-os = host-native @anthropic-ai/sandbox-runtime (Windows needs a one-time
#              `npx srt windows-install --skip-profile-grant`, UAC, and a console
#              session: that runtime denies its sandbox account remote logon).
#   wsl      = bubblewrap inside WSL2 (all networking off, read-only root, both homes
#              hidden; needs WSL2 with bwrap). Root is a Linux path for this provider.
# AROVA_SANDBOX_PROVIDER=
# AROVA_SANDBOX_ALLOWED_DOMAINS=example.com,api.github.com
# AROVA_SANDBOX_ROOT=
# AROVA_SANDBOX_TIMEOUT_MS=120000

# ── Web search (optional; tool-loop only) ──────────────────────────────────────
# Enables web_search for agents with the tool loop on and web_fetch granted.
# SearXNG and custom endpoints need no key; Brave needs one.
# SEARCH_PROVIDER=searxng
# SEARCH_BASE_URL=http://localhost:8888
# SEARCH_API_KEY=
# Set only for a deliberately local endpoint; it is refused otherwise.
# SEARCH_ALLOW_LOCAL=1

# ── Always-on scheduler (24/7) ─────────────────────────────────────────────────
# The server runs a loop that claims due routines, whether or not anyone has the app open.
# It lives as long as the server process does — see docs/ALWAYS-ON.md for hosting options.
# No inline comments on value lines: systemd's EnvironmentFile keeps them inside the value.
# SCHEDULER_WORKER accepts "on"/"off" (default on); SCHEDULER_INTERVAL_SECONDS is 5–600.
SCHEDULER_WORKER=on
SCHEDULER_INTERVAL_SECONDS=30
# An outside clock (Vercel Cron, GitHub Actions, cron-job.org, crontab) can call /api/cron.
# The endpoint stays closed until this is set. Generate one with: openssl rand -hex 32
CRON_SECRET=

# ── Docker only ────────────────────────────────────────────────────────────────
# Password for the bundled postgres in deploy/docker-compose.yml.
# POSTGRES_PASSWORD=change-me
# Apply the schema on container boot (drizzle-kit push --force). Only ever set this on a
# database this project owns — the image defaults to not pushing.
# DRIZZLE_PUSH=on

# ── Built-in provider overrides (optional) ─────────────────────────────────────
# XAI_BASE_URL / OPENAI_BASE_URL / OPENAI_MODEL override the built-ins' endpoints and
# default models; the key variables above still decide whether a provider is configured.
# XAI_BASE_URL=https://api.x.ai/v1
