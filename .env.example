# Copy this file to .env.local (gitignored; Next.js loads it automatically).
# Never commit real keys. .env* is deny-listed for agents in .claude/settings.json.

# ── Database ───────────────────────────────────────────────────────────────────
# Point this at a database this project OWNS (spec 25 recommends a dedicated
# `arova_local` database and `arova` role). On a shared Postgres host, do not
# reuse a database belonging to another app — `drizzle-kit push` refuses to run
# without this variable, and `npm run db:check` proves ownership before a push.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/arova_local

# ── Tool plane (spec 17) ───────────────────────────────────────────────────────
# AES-256-GCM key (32 bytes, hex) for the credential vault. Credentials are write-only:
# the server never returns a decrypted value, and without this key nothing is stored.
CREDENTIAL_ENCRYPTION_KEY=
# Hosts web_fetch may reach (exact host or subdomain match, space/comma separated).
# Empty means web_fetch stays refused. Private/metadata addresses are always refused.
TOOL_ALLOWED_HOSTS=

# ── Worker (spec 16) ───────────────────────────────────────────────────────────
# Retention (spec 19b) is opt-in: 0 or unset keeps everything forever.
# RETENTION_EVENTS_DAYS=90   # audit events older than this are deleted by the worker
# RETENTION_USAGE_DAYS=400   # daily usage rows older than this are deleted by the worker
# RETENTION_SWEEP_MS=3600000

# WORKER_CONCURRENCY=1  WORKER_POLL_MS=5000  WORKER_LEASE_MS=300000

# ── Built-in providers ─────────────────────────────────────────────────────────
# A key here makes the provider "configured"; without it chat stays in honest local mode.
XAI_API_KEY=
XAI_MODEL=grok-4
OPENAI_API_KEY=
FAST_MODEL=gpt-4o-mini

# ── Any OpenAI-compatible endpoint ─────────────────────────────────────────────
# 1. Add the provider's short name to PROVIDERS (space or comma separated).
# 2. Define <NAME>_BASE_URL, <NAME>_MODEL and <NAME>_API_KEY.
#    NAME is the provider name uppercased, with - and _ as separators:
#    "dahl" -> DAHL_*, "ollama-local" -> OLLAMA_LOCAL_*.
# 3. Restart the server. The provider appears in every agent's model picker — no code change.
#
# BASE_URL accepts either the API root (…/v1) or the full completions URL; the
# app appends /chat/completions itself. https is strongly recommended: the bearer
# key rides on this request. http is allowed only for a trusted local endpoint.
PROVIDERS=dahl
DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_MODEL=MiniMaxAI/MiniMax-M2.7
DAHL_API_KEY=
# Optional: this endpoint's context window in tokens. Caps how much chat history
# is sent per request (default 8192 for custom providers, 128000 for built-ins).
DAHL_MAX_CONTEXT=32000

# Self-hosted / LAN example (plain http is acceptable only on a trusted network):
# PROVIDERS="dahl ollama"
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=ollama
# OLLAMA_MAX_CONTEXT=8192

# ── Model call limits ──────────────────────────────────────────────────────────
# Model-call budget per workspace per provider per UTC day. 0 disables the limit.
# Absent = 60. Chats that stay in local mode are never counted.
DAILY_MODEL_CALLS_LIMIT=60
# How many teammates one answer may consult. Each hop costs extra model calls:
# a consulted answer is a routing call, the peer's call, then the integrating answer.
# 0 disables delegation entirely; absent = 2 peer hops.
MAX_DELEGATIONS=2

# History reserve when trimming a chat by context window (not the output cap; the
# reply's real output budget comes from the seat's effort / tokenBudgetFor).
# The unary and streaming response ceilings are in ms.
MODEL_MAX_TOKENS=800
MODEL_TIMEOUT_MS=45000
MODEL_STREAM_TIMEOUT_MS=120000

# ── Future integrations: do not set these until the adapters are implemented ─────
# Sign-in diagnostics only (Feature 15 foundation). AUTH_PROVIDERS + <NAME>_CLIENT_ID
# / _CLIENT_SECRET / _ISSUER make the Settings panel report whether the variables are
# present. They do NOT enable login: no auth routes, users, sessions or session cookie
# exist yet. With none set, the app stays the honest cookie demo.
# AUTH_PROVIDERS=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AUTH_SECRET=            # unused until the session flow is built
# COMPOSIO_API_KEY=       # unused; OAuth connectors are not implemented
# SANDBOX_PROVIDER=       # unused; the sandbox contract refuses by design
