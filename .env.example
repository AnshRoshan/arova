# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: ordinary chat model. Without this, Arova uses an explicit local fallback.
OPENAI_API_KEY=
FAST_MODEL=gpt-4o-mini

# Future integrations: do not set these until provider adapters are implemented.
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# COMPOSIO_API_KEY=
# SANDBOX_PROVIDER=
